# Membership uses separate credentials and tables from the existing call bookings.
# Copy these into .env.local. Never commit actual keys or signing secrets.
MEMBERSHIP_DATABASE_URL=postgresql://localhost/blacktemple_membership
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002
MEMBERSHIP_STRIPE_SECRET_KEY=
MEMBERSHIP_STRIPE_WEBHOOK_SECRET=
MEMBERSHIP_JOB_SECRET=
MEMBERSHIP_BILLING_MODE=test
MEMBERSHIP_CHECKOUT_ENABLED=false
MEMBERSHIP_PRICE_WITNESS=
MEMBERSHIP_PRICE_COMPANION=
MEMBERSHIP_PRICE_CHAMPION=
MEMBERSHIP_CAPACITY_COMPANION=12
MEMBERSHIP_CAPACITY_CHAMPION=3
# Live billing also requires MEMBERSHIP_LIVE_ENABLED=true and VERCEL_ENV=production.

# Account verification and password reset delivery. Capture never sends email.
MEMBERSHIP_EMAIL_MODE=capture
# Absolute private directory outside public/.next/out; only loopback auth/database.
MEMBERSHIP_EMAIL_CAPTURE_DIR=
# Hosted preview/production: verified sender, existing scoped API key, explicit send approval.
MEMBERSHIP_EMAIL_FROM=
MEMBERSHIP_EMAIL_REPLY_TO=
MEMBERSHIP_EMAIL_RESEND_API_KEY=
MEMBERSHIP_EMAIL_SEND_ENABLED=false

# Queue recovery: Vercel Cron calls /api/membership/process with CRON_SECRET (production only).
# Problems found on each run are emailed to this operator address; unset means logs only.
CRON_SECRET=
MEMBERSHIP_OPS_ALERT_EMAIL=

# Protected hosted sandbox: permit enrollment and delivery only for one approved inbox.
MEMBERSHIP_STAGING_MODE=false
MEMBERSHIP_EMAIL_ALLOWED_RECIPIENT=
